{
  "name": "galcad",
  "version": "0.3.0",
  "description": "GALCAD — CAD paramétrico com FEM/CFD integrado (OpenCASCADE, CalculiX, Gmsh, XFOIL)",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runner && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/run-all.cjs",
    "build:runner": "rolldown tools/cad-runner.ts --file public/cad-runner.mjs --platform node --format esm",
    "desktop": "npm run build && electron .",
    "solvers:win": "python3 desktop/build-solvers.py",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:e2e:desktop": "node tests/e2e/desktop.e2e.cjs",
    "lint": "oxlint src tools tests desktop --deny-warnings"
  },
  "author": "Galkeel",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/montserrat": "5.2.5",
    "@salusoft89/planegcs": "^1.3.0",
    "preact": "^11.0.2",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "oxlint": "1.90.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "productName": "GALCAD",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.galkeel.galcad",
    "productName": "GALCAD",
    "copyright": "© Galkeel",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/relocate.cjs",
      "package.json",
      "desktop/brand/splash-logo.png",
      "desktop/build/icon.png"
    ],
    "extraResources": [
      {
        "from": "desktop/solvers/win",
        "to": "solvers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/build/icon.ico",
      "signExecutable": false,
      "legalTrademarks": "Galkeel"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GALCAD",
      "artifactName": "GALCAD-Setup-${version}.exe",
      "language": "2070",
      "include": "desktop/installer.nsh",
      "installerIcon": "desktop/build/icon.ico",
      "uninstallerIcon": "desktop/build/icon.ico",
      "installerSidebar": "desktop/build/installerSidebar.bmp",
      "uninstallerSidebar": "desktop/build/uninstallerSidebar.bmp",
      "installerHeader": "desktop/build/installerHeader.bmp",
      "runAfterFinish": true,
      "menuCategory": "Galkeel",
      "uninstallDisplayName": "GALCAD (Galkeel)",
      "deleteAppDataOnUninstall": false
    }
  }
}
