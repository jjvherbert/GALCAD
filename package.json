{
  "name": "galcad",
  "version": "0.1.0",
  "description": "GALCAD — CAD paramétrico com FEM/CFD integrado (OpenCASCADE, CalculiX, Gmsh, XFOIL)",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:runner && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/app.e2e.cjs && node tests/e2e/navigation.e2e.cjs && node tests/e2e/surfaces.e2e.cjs && node tests/e2e/assembly.e2e.cjs && node tests/e2e/drawing.e2e.cjs && node tests/e2e/fase4.e2e.cjs && node tests/e2e/simulacao.e2e.cjs && node tests/e2e/pmi.e2e.cjs && node tests/e2e/script.e2e.cjs && node tests/e2e/galkeel.e2e.cjs && node tests/e2e/calc.e2e.cjs",
    "build:runner": "rolldown tools/cad-runner.ts --file public/cad-runner.mjs --platform node --format esm",
    "desktop": "npm run build && electron .",
    "solvers:win": "python3 desktop/build-solvers.py",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:e2e:desktop": "node tests/e2e/desktop.e2e.cjs"
  },
  "author": "Galkeel",
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@salusoft89/planegcs": "^1.3.0",
    "preact": "^11.0.2",
    "replicad": "^1.2.0",
    "replicad-opencascadejs": "^1.1.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "type": "module",
  "productName": "GALCAD",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.galkeel.galcad",
    "productName": "GALCAD",
    "copyright": "© Galkeel",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/relocate.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "desktop/solvers/win",
        "to": "solvers",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GALCAD",
      "artifactName": "GALCAD-Setup-${version}.exe",
      "language": "2070",
      "include": "desktop/installer.nsh"
    }
  }
}
