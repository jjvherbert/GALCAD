{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": { "correctness": "error" },
  "rules": {
    "no-control-regex": "off",
    "no-useless-spread": "off",
    "unicorn/no-new-array": "off"
  },
  "ignorePatterns": ["vendor/**", "dist/**", "release/**", "desktop/solvers/**"]
}
